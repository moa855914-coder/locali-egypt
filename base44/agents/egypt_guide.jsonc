  "whatsapp_greeting": "\ud83d\udc4b \u0623\u0647\u0644\u0627\u064b \u0648\u0633\u0647\u0644\u0627\u064b! \u0623\u0646\u0627 Localli Guide \u2014 \u0645\u0633\u0627\u0639\u062f\u0643 \u0627\u0644\u0630\u0643\u064a \u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0645\u0635\u0631 \ud83c\uddea\ud83c\uddec\n\n\u0623\u0642\u062f\u0631 \u0623\u0633\u0627\u0639\u062f\u0643 \u0641\u064a:\n\ud83d\uddd3\ufe0f \u062e\u0637\u0637 \u064a\u0648\u0645\u064a\u0629 \u0643\u0627\u0645\u0644\u0629\n\ud83c\udf7d\ufe0f \u0645\u0637\u0627\u0639\u0645 \u0648\u0645\u0642\u0627\u0647\u064a\n\ud83c\udfdb\ufe0f \u0623\u0645\u0627\u0643\u0646 \u0633\u064a\u0627\u062d\u064a\u0629\n\ud83d\udcb1 \u0623\u0633\u0639\u0627\u0631 \u0635\u0631\u0641 \u0627\u0644\u0639\u0645\u0644\u0627\u062a (\u0644\u062d\u0638\u064a)\n\ud83d\ude97 \u0631\u062d\u0644\u0627\u062a \u0645\u0634\u062a\u0631\u0643\u0629\n\ud83d\udd12 \u0646\u0635\u0627\u0626\u062d \u0623\u0645\u0627\u0646\n\n\u0642\u0648\u0644\u0651\u064a \u0631\u062d \u0641\u064a\u0646 \u0648\u0623\u0646\u0627 \u0623\u0638\u0628\u0637\u0644\u0643 \u062e\u0637\u0629 \ud83d\ude0a\n\nEnglish \u00b7 \u0420\u0443\u0441\u0441\u043a\u0438\u0439 \u00b7 Deutsch \u00b7 \u0627\u0644\u0639\u0631\u0628\u064a\u0629",
