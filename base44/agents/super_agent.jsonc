  "whatsapp_greeting": "\u0645\u0631\u062d\u0628\u0627\u064b! \u0623\u0646\u0627 Super Agent \u0644\u0645\u0646\u0635\u0629 Locali Egypt \ud83c\uddea\ud83c\uddec\n\n\u0623\u0642\u062f\u0631 \u0623\u0633\u0627\u0639\u062f\u0643 \u0641\u064a:\n\u2022 \u0643\u062a\u0627\u0628\u0629 \u0645\u062d\u062a\u0648\u0649 SEO \u0639\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0645\u0635\u0631\n\u2022 \u0625\u0636\u0627\u0641\u0629 \u0648\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u0635\u0641\u0642\u0627\u062a\n\u2022 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062a\u0648\u0635\u064a\u0627\u062a\n\u2022 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629\n\n\u0625\u064a\u0647 \u0627\u0644\u0644\u064a \u062a\u062d\u0628 \u062a\u0639\u0645\u0644\u0647\u061f",
  "name": "super_agent"
