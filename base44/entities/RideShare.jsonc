{
  "name": "RideShare",
  "type": "object",
  "properties": {
    "from_city": {
      "type": "string",
      "title": "From City"
    },
    "to_city": {
      "type": "string",
      "title": "To City"
    },
    "departure_date": {
      "type": "string",
      "format": "date",
      "title": "Departure Date"
    },
    "departure_time": {
      "type": "string",
      "title": "Departure Time"
    },
    "seats_available": {
      "type": "integer",
      "title": "Seats Available",
      "minimum": 1,
      "maximum": 8
    },
    "price_per_seat": {
      "type": "number",
      "title": "Price Per Seat (EGP)"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone/WhatsApp"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "car_type": {
      "type": "string",
      "title": "Car Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "full",
        "cancelled"
      ],
      "title": "Status",
      "default": "active"
    }
  },
  "required": [
    "from_city",
    "to_city",
    "departure_date",
    "seats_available",
    "price_per_seat",
    "contact_phone"
  ]
}